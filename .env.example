# Server Configuration
PORT=3000
NODE_ENV=development
TZ=UTC

# Redis Configuration (for Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Webhook URLs (optional)
WEBHOOK_JOB_START=
WEBHOOK_JOB_COMPLETE=
WEBHOOK_JOB_FAILED=

# Email Notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=YouTube Shorts Automation <your-email@gmail.com>
EMAIL_TO=recipient@example.com

# Slack Notifications (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=info

# API Configuration
AUTOMATION_API_URL=http://localhost:3000/api